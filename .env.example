# Copia este archivo como .env y ajusta los valores (opcional).
# Puerto en el que se publica el configurador en la red local.
CONFIGURADOR_PORT=8100
# Carpeta del host con modelos 3D personalizados.
CONFIGURADOR_MODELOS=./modelos
# Carpeta del host donde se guardan los coches subidos (mods de GTA V).
CONFIGURADOR_DATOS=./datos
# Usuario/grupo del contenedor (Unraid: nobody 99, users 100).
PUID=99
PGID=100
# Subida de coches: true/false, clave opcional y tamaño máximo por archivo.
SUBIDAS=true
CLAVE_SUBIDAS=
MAX_SUBIDA_MB=400
# Imagen a usar (normalmente no hace falta cambiarla).
CONFIGURADOR_IMAGE=ghcr.io/diego233l/customc:latest
TZ=Europe/Madrid
