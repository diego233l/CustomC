{
  "name": "configurador-tesla-3d",
  "private": true,
  "version": "1.0.0",
  "description": "Configurador 3D web para personalizar coches importados desde mods de GTA V (React + Three.js), listo para Docker/Unraid",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "start": "STATIC_DIR=dist DATA_DIR=./datos node server/server.mjs",
    "typecheck": "tsc --noEmit",
    "catalog:validate": "node scripts/validate-catalog.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "fflate": "^0.8.2",
    "node-unrar-js": "^2.0.2",
    "postprocessing": "^6.39.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.6"
  }
}
