{
  "name": "configurador-tesla-3d",
  "private": true,
  "version": "1.0.0",
  "description": "Configurador 3D web de Tesla Model S, 3, X e Y (React + Three.js), listo para Docker/Unraid",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "models:optimize": "node scripts/optimize-models.mjs",
    "catalog:validate": "node scripts/validate-catalog.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "postprocessing": "^6.39.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.2.1",
    "ajv": "^8.20.0",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.6"
  }
}
